# Sourced (set -a) by both launch scripts. Values extracted from the
# MiaAI-Lab recipe (.env.example + start.sh defaults) and the glm53 lane's
# K8s-proven fabric wiring. Empty string = flag omitted by launch script.
SERVED_MODEL_NAME=DeepSeek-v4.1-Flash-EXL3
PORT=8000
TP=2
NNODES=2
# CX7 fabric IP of chronometer (NCCL plane; NOT the 172.16.4.x API plane)
HEAD_IP=172.16.5.55
# dsv41-lane-unique (GLM 29521, DeepSeek 25000)
MASTER_PORT=29721
MODEL_DIR=/model
ENGRAM_MOUNT=/engram-src
DSV41_SOURCE=/engram-src
# Per-rank contiguous row stores on node-affine local NVMe PVCs.
DSV41_PACKED_DIR=/engram-packed
# --- quant / speculation
QUANTIZATION=exl3
ENFORCE_EAGER=0
EXL3_FUSED_MOE=1
# Upstream E3 v2 grouped K2/K3 mul1 prefill path.
EXL3_FAT_KERNEL=0
EXL3_FAT_GROUPED=1
EXL3_FAT_SORTED=0
EXL3_FAT_BATCHED=0
EXL3_TEMP_ROWS_FUSED=8
SPEC_METHOD=dspark
DSPARK_TOKENS=3
# --- memory discipline (recipe shipped defaults; GB10 UMA)
MAX_MODEL_LEN=600000
GPU_MEM_UTIL=0.88
# Admit interactive requests concurrently; KV remains hard-capped below.
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=3072
LONG_PREFILL_TOKEN_THRESHOLD=2816
KV_CACHE_MEMORY_BYTES=2684354560
KV_BLOCK_SIZE=64
KV_CACHE_DTYPE=
LANGUAGE_MODEL_ONLY=1
LIMIT_MM=
SKIP_MM_PROFILING=1
# The checkpoint template is byte-identical to the pinned recipe template.
CHAT_TEMPLATE=
# DSpark k=3 capture geometry from the upstream recipe.
EXTRA_ARGS="--cudagraph-capture-sizes 1 2 3 4 6 8 12 18 24"
# --- EXL3 / DSV41 runtime knobs
DSV41_EXL3_SERIAL_STREAMS=1
VLLM_DISABLE_SHARED_EXPERTS_STREAM=1
DSV41_ENGRAM_DISABLE=0
DSV41_CACHE_GIB=0
DSV41_RESIDENT_SCALES=0
DSV41_IO_THREADS=32
DSV41_CACHE_WAYS=4
DSV41_STATS_SECONDS=60
DSV41_INDEXER_PREFILL_FACTOR=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
DSV41_PREFILL_EMPTY_CACHE_MEMAVAIL_GIB=2.5
DSV41_PREFILL_END_EMPTY_CACHE=0
DSV41_SKIP_MIXED_WARMUP=0
DSV41_DROP_PAGE_CACHE=1
DSV41_MEM_GUARD=0
DSV41_MEM_GUARD_GIB=1.5
DSV41_BOOT_MARGIN_GIB=12
GLM53_SUPPRESS_STOPS_IN_REASONING=1
GLM53_MIXED_PREFILL_CHUNK=0
GLM53_SPINWAIT_MS=stock
# --- NCCL over CX7 (glm53-lane proven pins on this kit)
NCCL_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=mlx5_1:1
NCCL_IB_GID_INDEX=3
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_IB_DISABLE=0
NCCL_CROSS_NIC=0
NCCL_IB_MERGE_NICS=0
NCCL_NVLS_ENABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
# UMA pinned-buffer shrink from the native DS4.1 recipe
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
# --- boot/warmup/timeouts
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
DSV41_BOOT_SHAPE_WARMUP=1
DSV41_WARMUP_REQ_TIMEOUT=240
# The baked shape-warmer consumes the inherited GLM53_* variable names.
GLM53_WARMUP_REQ_TIMEOUT=240
GLM53_WARMUP_MAX_CONCURRENCY=2
GLM53_WARMUP_DSPARK_K=3
GLM53_WARMUP_TRITON_CACHE_DIR=/root/.triton/cache
VLLM_ENGINE_READY_TIMEOUT_S=3600
# --- auth (inject via secret when enabling; empty = no auth on the lane)
VLLM_API_KEY=
