# GLM-5.3-Flash EXL3 parity — resolved runtime profile (documentation).
#
# This is the resolved env matrix the parity Deployments set directly (start.sh
# passes these via `docker run -e`; here they are set as container env). The
# serve argv itself is composed in-container by the `args` script in
# 12-glm53-parity.yaml. Shown for parity comparison with the DeepSeek lane's
# `12-miaai-profile.env`.
#
# Default `.env` resolution for the 2-node / TP=2 / DFlash2 config.

# --- serve / model ---
SERVED_MODEL_NAME=GLM-5.3-Flash-EXL3
PORT=8000
TP=2
NNODES=2
HEAD_IP=172.16.5.55
MASTER_PORT=29521
QUANTIZATION=exl3
MAX_MODEL_LEN=512000
GPU_MEM_UTIL=0.88
# Upstream's independently measured high-concurrency geometry.
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=2048
LONG_PREFILL_TOKEN_THRESHOLD=
KV_CACHE_DTYPE=fp8
MTP_TOKENS=0
SPEC_METHOD=dflash
DFLASH_TOKENS=7
DFLASH_DRAFT_TP=2
LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1
LIMIT_MM={"image":100,"video":1}
CHAT_TEMPLATE=/opt/glm53/chat_template.jinja
ENFORCE_EAGER=0
EXTRA_ARGS=--cudagraph-capture-sizes 1 2 4 8 16 24 32 --kv-cache-memory-bytes 12884901888

# --- exl3 fat-moe ---
EXL3_FUSED_MOE=1
EXL3_MOE_ROW_TILE=0
EXL3_TEMP_ROWS_FUSED=32
EXL3_FAT_SORTED=0
EXL3_FAT_BATCHED=0
EXL3_FAT_KERNEL=1
EXL3_FAT_GROUPED=1

# --- ablit (off) ---
ABLIT=0
ABLIT_METHOD=auto
ABLIT_DIRECTION=dealign
ABLIT_LAYERS=15-45
ABLIT_ALPHA=3.0
ABLIT_INCLUDE_MTP=1

# --- GLM53 decode knobs ---
GLM53_ADAPTIVE_K=off
GLM53_ADAPTIVE_K_SET=2,4,7
GLM53_ADAPTIVE_K_ALPHA=0.25
GLM53_ADAPTIVE_K_MARGIN=1.0
GLM53_ADAPTIVE_K_MIN_STEPS=4
GLM53_ADAPTIVE_K_SATURATE=max
GLM53_ADAPTIVE_K_HIST=200
GLM53_DENSE_FP8=off
GLM53_SUPPRESS_STOPS_IN_REASONING=1
# Keep vLLM continuous batching enabled; do not defer prefills behind decode.
GLM53_MIXED_PREFILL_CHUNK=off
GLM53_DEFAULT_REASONING_EFFORT=
GLM53_INDEXER_WORKSPACE=rightsize
GLM53_SPINWAIT_MS=stock

# --- HF / cache ---
HF_HOME=/cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_CACHE_ROOT=/root/.cache/vllm
TRITON_CACHE_DIR=/root/.triton/cache
TILELANG_CACHE_DIR=/root/.tilelang/cache
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_ENGINE_READY_TIMEOUT_S=3600
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=1

# --- NCCL / CX7 backplane (rank-specific) ---
NCCL_IB_DISABLE=0
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_NVLS_ENABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IB_MERGE_NICS=0
NCCL_CROSS_NIC=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_SOCKET_IFNAME=enp1s0f1np1   # head; worker also enp1s0f1np1 on this kit
GLOO_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=mlx5_1:1             # RDMA device/port; socket interface is enp1s0f1np1
NCCL_IB_GID_INDEX=2               # carries the ::ffff:172.16.5.x RoCE entry
VLLM_HOST_IP=172.16.5.55          # head; worker 172.16.5.56
