# Python runtime layer for the immutable native recipe 4835fc852d34 image.
# Placeholder is intentionally rejected by the suspended Job until the native manifest is verified.
# configure-rdma-fabric.sh uses Python's stdlib to validate node inventory and select NCCL HCA/GID values.
FROM local-registry.registry.svc.cluster.local:5000/homelab/tensorfold-glm53-flash-1104:4835fc852d34@sha256:REPLACE_WITH_NATIVE_MANIFEST_SHA256

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -c 'import ipaddress, json, pathlib, shlex; print("python3 runtime ready")'
